<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Global Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>autofallout</ToolCommandName>
    <PackageId>MeddlingIdiot.Fallout.Builder</PackageId>
    <Description>A global tool to simplify Fallout build setup across projects. Installs as 'autofallout'.</Description>
    <PackageTags>fallout;build;ci;dotnet-tool;automation</PackageTags>

        <!-- ── Packaging ────────────────────────────────────────────────────
             Published to nuget.org under the MeddlingIdiot name. The id is
             deliberately *not* the old Automation.Fallout.* one: the work repository this
             was forked from still publishes those ids to its own feed, and one id served by
             two feeds from two diverged codebases resolves to whichever version number is
             higher — silently, and differently on different machines.

             The assembly and namespaces keep their old names on purpose, so every consuming
             Build.cs keeps compiling after nothing more than a PackageReference change.
        -->
        <Authors>MeddlingIdiot</Authors>
        <Company>MeddlingIdiot</Company>
        <Copyright>Copyright © MeddlingIdiot</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/meddlingidiot/MeddlingIdiot.Fallout.Components</PackageProjectUrl>
        <RepositoryUrl>https://github.com/meddlingidiot/MeddlingIdiot.Fallout.Components</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://dev.azure.com/AFTR/Automation/_git/Automation.Fallout.Builder</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude DefaultRootItems from default Content inclusion to avoid duplicates -->
    <Content Remove="DefaultRootItems\**\*" />

    <!-- Embed DefaultRootItems files as embedded resources -->
    <EmbeddedResource Include="DefaultRootItems\**\*" />
  </ItemGroup>


    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
