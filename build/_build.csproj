<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
    <!-- SDK 10.0.400's MSBuild binds NuGet.Frameworks 7.9.0.0 when it evaluates
         [MSBuild]::GetTargetFrameworkIdentifier, and the copy next to the build host wins probing,
         so an older one makes project parsing die with a manifest mismatch. Fallout.Common 10.4.0
         pulled NuGet.Packaging 6.14.3 and did exactly that; 10.5.0 depends on 7.9.0 itself. The
         pin stays explicit so the NuGet line cannot drift from the SDK in global.json unnoticed. -->
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <!-- Automation.Fallout.Components is deliberately a ProjectReference below and not a
         PackageReference: this repository builds itself with its own components, so the build has
         to compile against the working tree rather than whatever was last published. -->
    <PackageReference Include="MeddlingIdiot.Fallout.Components" Version="1.0.28" />
  </ItemGroup>
  <ItemGroup>
    <PackageDownload Include="GitVersion.Tool" Version="[6.8.2]" />
    <PackageDownload Include="ReportGenerator" Version="[5.5.11]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Automation.Fallout.Components\Automation.Fallout.Components.csproj" />
  </ItemGroup>
</Project>
