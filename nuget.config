<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org only. The AFTR feeds and their Automation.*/ProMiles*/PM* mappings went with the
  mirror: nothing in this repository comes from them any more, and leaving a 401-ing private
  feed in the list makes every restore on a machine without those credentials fail for a
  reason that has nothing to do with the build.

  Fallout.Common and Fallout.Build are on nuget.org, including the 11.x line this builds
  against, so the dependency chain is entirely public.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
